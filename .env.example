# Copy to .env. .env is gitignored and must never be committed.
# Key holder: Bikram Bhattarai.
OSHC_API_KEY=
# Leave blank to use the only budgeted model, claude-haiku-4-5-20251001.
OSHC_MODEL=
# Haiku chat is the normal application mode. Every answer is reviewed before display.
# Student questions/drafts bypass disk cache. Bills stay local in either mode.
OSHC_OFFLINE=0
OSHC_ENABLE_LIVE=1
# Keep using an existing budget ledger by supplying its absolute path here.
# For a genuinely new installation only: python -m oshc.llm_budget init
# Do not reset an existing allowance. Tests explicitly use source-only mode.
OSHC_BUDGET_LEDGER=
