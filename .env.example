# Copy to .env. .env is gitignored and must never be committed.
# Key holder: Bikram Bhattarai.
OSHC_API_KEY=
# Leave blank to use the only budgeted model, claude-haiku-4-5-20251001.
OSHC_MODEL=
# Offline by default: answers come from cache/llm/v2 and a cache miss raises.
# Paid calls need BOTH OSHC_OFFLINE=0 and OSHC_ENABLE_LIVE=1, plus a spending
# ledger created once with: python -m oshc.llm_budget init
# See docs/prototype/llm_runtime.md.
OSHC_OFFLINE=1
OSHC_ENABLE_LIVE=0
