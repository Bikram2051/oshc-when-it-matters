# Secrets. Never commit.
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.key

# Third-party content we may store for research but must not republish.
corpus/*
!corpus/.gitkeep
!corpus/MANIFEST.csv

# Anything resembling a real document. Belt and braces.
**/real/**
*.real.pdf

# Held-out evaluation material. Released on evaluation day only.
data/heldout/*
!data/heldout/.gitkeep

# Local
.venv/
__pycache__/
*.pyc
.pytest_cache/
.test-tmp/
tmp/
data/events.sqlite
.DS_Store
.idea/
.vscode/

# Legacy synthetic research cache entries are already tracked for reproducibility.
# New runtime responses can contain student text and must never enter Git.
/cache/llm/**
/cache/live/**

data/freeze/
*.egg-info/

# Persistent local API spending ledger
/data/private_runtime/

# Public reference documents downloaded from external sources
data/public_samples/*.pdf
